    {
      "parameters": {
        "jsCode": "// ===== CONFIG: edit everything here =====\nconst CONFIG = {\n  enforceCallingHours: false,  // TESTING ONLY: set back to true before submission\n  timezone: 'Asia/Karachi',\n  startHour: 10,               // calls allowed from 10:00 ...\n  endHour: 18,                 // ... until 17:59\n  allowedDays: [1, 2, 3, 4, 5, 6], // Mon=1 ... Sun=7 (Sunday off)\n  maxAttempts: 3,              // 1 first call + 2 retries\n  retryGapMinutes: 120,        // wait before retrying a no-answer / error\n  staleCallMinutes: 20,        // \"calling\" this long with no webhook = lost call\n  maxCallsPerRun: 2,\n  defaultCountryCode: '92',\n  assistantId: '2b7eda6c-a333-4ab1-8050-ba81c6bc3c98',\n  phoneNumberId: '4221c6cb-c926-4ecc-b468-87a0fb5190e6',\n};\n\n// ===== 1. Calling-hours guard =====\nif (CONFIG.enforceCallingHours) {\n  const parts = new Intl.DateTimeFormat('en-GB', {\n    timeZone: CONFIG.timezone, hour: 'numeric', hour12: false, weekday: 'short',\n  }).formatToParts(new Date());\n  const hour = parseInt(parts.find(p => p.type === 'hour').value, 10) % 24;\n  const dayMap = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };\n  const day = dayMap[parts.find(p => p.type === 'weekday').value];\n  if (!CONFIG.allowedDays.includes(day) || hour < CONFIG.startHour || hour >= CONFIG.endHour) {\n    return []; // outside calling hours: no calls\n  }\n}\n\n// ===== 2. Helpers =====\nconst rows = $input.all().map(i => i.json).filter(r => r.id && r.number);\nconst isTrue = v => ['true', 'yes', '1', 'y'].includes(String(v || '').trim().toLowerCase());\nconst norm = n => {\n  const d = String(n || '').replace(/[^\\d+]/g, '');\n  if (d.startsWith('+')) return d;\n  if (d.startsWith('00')) return '+' + d.slice(2);\n  if (d.startsWith('0')) return '+' + CONFIG.defaultCountryCode + d.slice(1);\n  return '+' + d;\n};\n\n// ===== 3. Do-not-call list (by NUMBER, so duplicates are blocked too) =====\nconst dnc = new Set(\n  rows.filter(r => isTrue(r.do_not_call) || String(r.status).trim().toLowerCase() === 'do_not_call')\n      .map(r => norm(r.number))\n);\n\n// ===== 4. Pick eligible leads =====\nconst nowMs = Date.now();\nconst out = [];\nlet calls = 0;\nfor (const r of rows) {\n  if (calls >= CONFIG.maxCallsPerRun) break;\n  const number = norm(r.number);\n  if (dnc.has(number)) continue;\n\n  const status = String(r.status || 'pending').trim().toLowerCase();\n  const attempts = parseInt(r.attempts || 0, 10) || 0;\n  const last = Date.parse(r.last_call_time);\n  const minsSince = isNaN(last) ? Infinity : (nowMs - last) / 60000;\n  let note = '';\n\n  if (status === 'calling') {\n    if (minsSince < CONFIG.staleCallMinutes) continue;       // call still in progress\n    note = 'No end-of-call report received (timeout)';\n  } else if (status === 'callback') {\n    const cb = Date.parse(r.callback_time);\n    if (isNaN(cb) || cb > nowMs) continue;                   // callback not due yet\n    if (attempts >= CONFIG.maxAttempts) continue;\n  } else if (['pending', 'no_answer', 'error'].includes(status)) {\n    if (attempts >= CONFIG.maxAttempts && status !== 'calling') continue;\n    if (attempts > 0 && minsSince < CONFIG.retryGapMinutes) continue;\n  } else {\n    continue; // interested / not_interested / do_not_call: finished\n  }\n\n  // A lost call that already used all attempts is closed as an error, not re-dialled\n  const skip = status === 'calling' && attempts >= CONFIG.maxAttempts;\n  if (!skip) calls++;\n  out.push({ json: {\n    id: r.id, name: r.name, company: r.company, number,\n    new_attempts: skip ? attempts : attempts + 1,\n    new_status: skip ? 'error' : 'calling',\n    skip_call: skip,\n    error_note: note,\n    now_iso: new Date().toISOString(),\n    assistant_id: CONFIG.assistantId,\n    phone_number_id: CONFIG.phoneNumberId,\n  }});\n}\nreturn out;\n"
      },
